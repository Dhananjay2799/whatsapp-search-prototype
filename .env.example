# Copy to .env. Never commit .env, documents/, .private/ or whatsapp-auth/.
INDEX_MESSAGES=1
# Import older WhatsApp chats (1 = on). Only sent when a device is first linked; see README.
WHATSAPP_FULL_HISTORY=0
# OCR languages for photos and scanned PDFs, e.g. eng+guj+hin (data downloads on first use).
OCR_LANGS=eng
# Optional exact HTTPS hostname used by Tailscale Serve:
TAILSCALE_HOST=
# Google OAuth Web application. Enable Gmail API and add your email as a test user.
# Authorized redirect URI: http://localhost:3000/auth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft app registration: organizational directories AND personal accounts.
# Web redirect URI: http://localhost:3000/auth/outlook/callback
# Delegated permissions: User.Read, Mail.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
